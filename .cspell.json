{
  "enableFiletypes": [
    "git-commit",
    "github-actions-workflow",
    "julia",
    "jupyter"
  ],
  "flagWords": [
    "analyse",
    "colour",
    "comparision",
    "favour",
    "flavour",
    "hte",
    "optimise",
    "paramater",
    "parmater",
    "transision",
    "transisions"
  ],
  "ignorePaths": [
    "**/.cspell.json",
    "*.ico",
    ".editorconfig",
    ".envrc",
    ".github/dependabot.yml",
    ".gitignore",
    ".pre-commit-config.yaml",
    ".prettierignore",
    ".vscode/*",
    "docs/_templates/*",
    "docs/conf.py",
    "pyproject.toml"
  ],
  "ignoreWords": [
    "compwa",
    "prereleased",
    "pydantic",
    "pypa",
    "pypi",
    "toctree"
  ],
  "language": "en-US",
  "useGitignore": true,
  "version": "0.2",
  "words": ["docstrings", "pyproject", "rawsource"]
}
